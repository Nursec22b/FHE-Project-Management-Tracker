# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://fhe_user:your_password@localhost:5432/fhe_project_board

# JWT Secret (generate a strong random string)
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=7d

# Microsoft Graph API (for email automation)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Email automation
EMAIL_POLL_INTERVAL_MS=60000
EMAIL_MONITORED_MAILBOX=tasks@floridahorizoneng.com

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
